{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./apps/frontend/src/*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "prisma/**/*.ts",
    "scripts/**/*.ts"
  ]
}
