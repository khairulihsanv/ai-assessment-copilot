// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  DOSEN
  MAHASISWA
}

enum ClassRole {
  STUDENT
  ASSISTANT
}

enum SubmissionType {
  TEXT
  PDF
  DOCX
  ANY
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  AI_PROCESSING
  AI_REVIEWED
  GRADED
}

enum SourceType {
  ANSWER_KEY
  MATERIAL
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}

enum JobType {
  DOCUMENT_EXTRACT
  DOCUMENT_INDEX
  EVALUATION
}

enum DocumentStatus {
  UPLOADING
  UPLOADED
  EXTRACTING
  REVIEW_REQUIRED
  APPROVED
  INDEXING
  READY
  FAILED
  RETIRED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  avatarUrl    String?
  createdAt    DateTime @default(now())

  // Relations
  ownedClasses   Class[]      @relation("DosenClasses")
  enrollments    Enrollment[]
  submissions    Submission[]
  gradedGrades   GradeRevision[] @relation("GradedByDosen")
  createdRubrics Rubric[]
  
  ownedDocuments Document[]
  approvedDocuments DocumentVersion[] @relation("DocumentApprovals")
  approvedReferenceSets ReferenceSetVersion[] @relation("ReferenceSetApprovals")

  @@map("users")
}

model Class {
  id            String   @id @default(cuid())
  name          String
  description   String?
  subject       String?
  enrollmentKey String   @unique
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())

  // Relations
  dosenId     String
  dosen       User         @relation("DosenClasses", fields: [dosenId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  rubrics     Rubric[]
  assignments Assignment[]

  @@map("classes")
}

model Enrollment {
  id       String    @id @default(cuid())
  role     ClassRole @default(STUDENT)
  joinedAt DateTime  @default(now())

  // Relations
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId  String @map("mahasiswaId")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@map("enrollments")
}

model Rubric {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())

  // Relations
  classId     String
  class       Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  criteria    RubricCriterion[]
  assignments Assignment[]

  @@map("rubrics")
}

model RubricCriterion {
  id             String  @id @default(cuid())
  label          String
  description    String?
  maxScore       Float
  weight         Float // percentage, all criteria in a rubric should sum to 100
  expectedAnswer String? // Legacy: keyword matching (kept for backward compat)

  // Vector-based grading fields
  answerKey          String? @db.Text // Full answer key from dosen
  material           String? @db.Text // Reference material/materi from dosen
  answerKeyEmbedding Json? // Embedding vector for answer key (Float[])
  materialEmbedding  Json? // Embedding vector for material (Float[])

  // Relations
  rubricId String
  rubric   Rubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)

  @@map("rubric_criteria")
}

model Assignment {
  id                  String           @id @default(cuid())
  title               String
  instructions        String
  submissionType      SubmissionType   @default(ANY)
  dueDate             DateTime
  maxScore            Float            @default(100)
  allowLateSubmission Boolean          @default(false)
  status              AssignmentStatus @default(DRAFT)
  createdAt           DateTime         @default(now())

  // Relations
  classId     String
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  rubricId    String?
  rubric      Rubric?      @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  submissions Submission[]
  
  documents   Document[]
  referenceSets ReferenceSetVersion[]

  @@map("assignments")
}

