# ─────────────────────────────────────────────────────────────
# Dexa Assessment: environment for `docker compose up`
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Shared secret between the frontend (BFF) and the backend. Required, at least 32 characters.
# Generate one: openssl rand -base64 48
INTERNAL_API_SECRET=

# PostgreSQL (container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_assessment_copilot

# Ports on this machine. Change them if something else already uses them.
FRONTEND_PORT=3000
BACKEND_PORT=3001
POSTGRES_PORT=5432

# Which model writes the AI drafts: ollama (local, default), groq or gemini.
LLM_PROVIDER=ollama
# Ollama running on this machine (default). With `--profile ollama` use http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Only for LLM_PROVIDER=groq or gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=

# Origins allowed to call the backend directly, as a JSON list.
CORS_ORIGINS=["http://localhost:3000"]

# Create the demo lecturer, student, class and essay on start (true/false).
SEED_DEMO=true

# Tailscale Funnel (only with `--profile tunnel`): a public HTTPS URL for the backend.
# Auth key: https://login.tailscale.com/admin/settings/keys (not reusable, not ephemeral).
# Only needed for the first start; the login is kept in the tailscale_state volume.
TS_AUTHKEY=
TS_HOSTNAME=dexa-backend
