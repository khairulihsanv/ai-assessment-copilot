# ─────────────────────────────────────────────────────────────
# Dexa Assessment: environment for `docker compose up`
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Shared secret between the frontend (BFF) and the backend. Required, at least 32 characters.
# Generate one: openssl rand -base64 48
INTERNAL_API_SECRET=

# PostgreSQL (container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_assessment_copilot

# Ports on this machine. Change them if something else already uses them.
FRONTEND_PORT=3000
BACKEND_PORT=3001
POSTGRES_PORT=5432

# Which model writes the AI drafts: ollama (local, default), groq or gemini.
LLM_PROVIDER=ollama
# Ollama running on this machine (default). With `--profile ollama` use http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Only for LLM_PROVIDER=groq or gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=

# OCR for photographed / scanned answer sheets.
# rapidocr = local and free, fine for printed text. vision = a vision model reads every page
# (best for handwriting). auto = rapidocr first, poorly read pages go to the vision model.
OCR_ENGINE=auto
# Vision model for handwriting: none, groq (uses GROQ_API_KEY) or ollama (ollama pull qwen2.5vl:7b).
OCR_VISION_PROVIDER=none
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Upload limits: one document (MB), pages per scan, size of one page photo (MB).
MAX_FILE_SIZE_MB=25
SCAN_MAX_PAGES=40
SCAN_MAX_IMAGE_MB=10
# Skip cover, preface, table of contents and bibliography of long reports when grading (saves tokens).
CLEAN_REPORT_BOILERPLATE=true
# gpt-oss on Groq: low reasoning effort uses far fewer tokens per draft. Empty = Groq default.
GROQ_REASONING_EFFORT=low

# Origins allowed to call the backend directly, as a JSON list.
CORS_ORIGINS=["http://localhost:3000"]

# Backend mode. "production" hides internal error details and the /docs page.
# Use "development" locally if you want the interactive API docs at /docs.
BACKEND_ENV=production

# Create the demo lecturer, student, class and essay on start (true/false).
SEED_DEMO=true

# Tailscale Funnel (only with `--profile tunnel`): a public HTTPS URL for the backend.
# Auth key: https://login.tailscale.com/admin/settings/keys (not reusable, not ephemeral).
# Only needed for the first start; the login is kept in the tailscale_state volume.
TS_AUTHKEY=
TS_HOSTNAME=dexa-backend
