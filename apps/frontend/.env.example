# ─────────────────────────────────────────────────────────────
# Dexa Assessment frontend (Next.js BFF)
# Local: copy to apps/frontend/.env.local. Vercel: set these in Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Where the FastAPI backend lives. Local: http://127.0.0.1:3001. Production: the backend's https URL.
BACKEND_URL=http://127.0.0.1:3001

# Must equal INTERNAL_API_SECRET in the backend. At least 32 characters.
INTERNAL_API_SECRET=

# true in production (https), false for http://localhost
COOKIE_SECURE=false
