# ─────────────────────────────────────────────────────────────
# Dexa Assessment backend (FastAPI) — run without Docker
# Copy to apps/backend/.env. Docker users: use the root .env.example instead.
# ─────────────────────────────────────────────────────────────

# PostgreSQL 16 with the pgvector extension
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ai_assessment_copilot
# Tests only: must point to a database whose name ends in _test
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ai_assessment_test

# Required, at least 32 characters. Must equal INTERNAL_API_SECRET in the frontend.
# Lookup order: INTERNAL_API_SECRET, SECRET_KEY, AUTH_SECRET, NEXTAUTH_SECRET (no built-in fallback).
INTERNAL_API_SECRET=

# Origins allowed to call the backend directly, as a JSON list.
CORS_ORIGINS=["http://localhost:3000"]

# Uploaded answers and scans. Use a persistent disk in production.
STORAGE_DIR=./storage

# AI draft model: ollama (default, local), groq or gemini.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Longest silence while the model writes (seconds), and the cap for one draft.
LLM_TIMEOUT_SECONDS=300
LLM_TOTAL_TIMEOUT_SECONDS=1800

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OCR for photographed / scanned answer sheets.
# rapidocr = local and free, fine for printed text. vision = a vision model reads every page
# (best for handwriting). auto = rapidocr first, poorly read pages go to the vision model.
OCR_ENGINE=auto
# Vision model for handwriting: none, groq (uses GROQ_API_KEY) or ollama (ollama pull qwen2.5vl:7b).
OCR_VISION_PROVIDER=none
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Upload limits: one document (MB), pages per scan, size of one page photo (MB).
MAX_FILE_SIZE_MB=25
SCAN_MAX_PAGES=40
SCAN_MAX_IMAGE_MB=10
# Skip cover, preface, table of contents and bibliography of long reports when grading (saves tokens).
CLEAN_REPORT_BOILERPLATE=true
# gpt-oss on Groq: low reasoning effort uses far fewer tokens per draft. Empty = Groq default.
GROQ_REASONING_EFFORT=low

# Student names, NIM, e-mail and phone numbers are masked before text reaches the model.
ANONYMIZE_STUDENT_DATA=true
