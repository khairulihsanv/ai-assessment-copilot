# ─────────────────────────────────────────────────────────────
# Dexa Assessment backend (FastAPI) — run without Docker
# Copy to apps/backend/.env. Docker users: use the root .env.example instead.
# ─────────────────────────────────────────────────────────────

# PostgreSQL 16 with the pgvector extension
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ai_assessment_copilot
# Tests only: must point to a database whose name ends in _test
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ai_assessment_test

# Required, at least 32 characters. Must equal INTERNAL_API_SECRET in the frontend.
# Lookup order: INTERNAL_API_SECRET, SECRET_KEY, AUTH_SECRET, NEXTAUTH_SECRET (no built-in fallback).
INTERNAL_API_SECRET=

# Origins allowed to call the backend directly, as a JSON list.
CORS_ORIGINS=["http://localhost:3000"]

# Uploaded answers and scans. Use a persistent disk in production.
STORAGE_DIR=./storage

# AI draft model: ollama (default, local), groq or gemini.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Longest silence while the model writes (seconds), and the cap for one draft.
LLM_TIMEOUT_SECONDS=300
LLM_TOTAL_TIMEOUT_SECONDS=1800

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Student names, NIM, e-mail and phone numbers are masked before text reaches the model.
ANONYMIZE_STUDENT_DATA=true
