# ====================================================================
# Dexa Assessment Backend (FastAPI / Python) — Environment Variables
# ====================================================================

# Database: PostgreSQL with pgvector extension
DATABASE_URL=postgresql://user:password@localhost:5432/dexa_assessment

# Security & Authentication
SECRET_KEY=change_this_to_a_secure_random_32_byte_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# Storage
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# LLM Providers Configuration
# Groq (Cloud LLM)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (Self-Hosted / Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
