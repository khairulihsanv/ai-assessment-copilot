{
  "name": "dexa-assessment-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "lint": "biome check .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "tsx scripts/run-e2e-harness.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3"
  }
}
